# À copier en .env à la racine du projet (LabMedis/) — pas dans bot/
# docker-compose lit automatiquement le .env de sa racine

# Token du bot obtenu via @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé API OpenAI (platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle OpenAI à utiliser (défaut gpt-4o-mini — cheap et rapide, tool-calling solide)
# Alternatives : gpt-4o (plus puissant, ~15x plus cher), gpt-4.1, gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini

# Liste des chat_ids Telegram autorisés (séparés par virgule).
# Vide = accès ouvert à tous ⚠️ — ne pas laisser vide en prod.
# Pour trouver ton chat_id : parle au bot une fois avec /start (il te répondra ton chat_id).
ALLOWED_TELEGRAM_CHAT_IDS=123456789,987654321
